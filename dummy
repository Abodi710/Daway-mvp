app.get('/api/reports/profits', verifyToken, authorize(ROLES.ADMIN, ROLES.OWNER), async (req, res) => {
  try {
    let sql = `
      SELECT u.pharmacy_name AS pharmacy,
             SUM(s.total_price) AS total_revenue,
             COUNT(s.id) AS total_sales
      FROM sales s
      JOIN users u ON s.user_id = u.id
      LEFT JOIN medicines m ON s.medicine_id = m.id
    `;
    const params = [];
    if (req.userRole !== ROLES.ADMIN) {
      sql += ' WHERE s.user_id = ?';
      params.push(req.ownerId);
    }
    sql += ' GROUP BY u.id';
    const rows = await dbAll(sql, params);
    res.json(rows);
  } catch (err) {
    console.error('Error in profits report:', err);
    res.status(500).json({ error: err.message });
  }
});