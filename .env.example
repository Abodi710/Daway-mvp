# ============================================================
# Daway — نموذج متغيرات البيئة / Environment variable template
# ============================================================
# Copy this file to `.env` and replace every placeholder below.
#
#   cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed.
# This file (`.env.example`) contains placeholders ONLY — never put
# a real secret, password, or production hostname in it.


# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
# Port the Express API listens on.
PORT=5000

# Set to "production" when deploying. In any value other than
# "production" the server auto-opens a browser tab on Windows at boot.
NODE_ENV=development


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API with
# credentials. No trailing slash; scheme + host + port must match exactly.
# Defaults to http://localhost:5173 (Vite dev server) when unset.
# Requests with no Origin header (curl, Postman, same-origin) are allowed;
# a browser request from an unlisted origin is refused CORS headers and
# blocked by the browser, with a "CORS: blocked origin ..." warning logged.
#
#   dev:  ALLOWED_ORIGIN=http://localhost:5173
#   prod: ALLOWED_ORIGIN=https://app.example.com,https://www.example.com
ALLOWED_ORIGIN=http://localhost:5173


# ------------------------------------------------------------
# JWT_SECRET  (REQUIRED — server refuses to boot without it)
# ------------------------------------------------------------
# Signing key for all auth tokens. The server exits at startup if this is
# missing or left as the literal string "your_secret_key_here".
#
# Generate a fresh value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# --- Rotating JWT_SECRET ---
# 1. Generate a new value with the command above.
# 2. Replace JWT_SECRET in `.env` (keep the old value only until step 4
#    is confirmed, in case you need to roll back).
# 3. Restart the server.
# 4. Effect: every previously issued token is invalidated immediately —
#    all users, including admins, are logged out and must sign in again.
#    There is no grace period, so prefer a low-traffic window.
# Rotate on: any suspected leak, a committed `.env`, staff offboarding,
# and on a routine schedule (every 90 days is a reasonable default).
JWT_SECRET=replace_me_with_a_64_char_random_hex_string


# ------------------------------------------------------------
# Bootstrap admin account
# ------------------------------------------------------------
# Email of the admin account created on first boot (REQUIRED — the server
# refuses to boot without it or ROOT_ADMIN_EMAIL). There are no built-in admin
# addresses: admin rights come only from `users.role` in the database.
ADMIN_EMAIL=admin@example.com

# Optional fallback used only when ADMIN_EMAIL is unset.
ROOT_ADMIN_EMAIL=admin@example.com

# ADMIN_PASSWORD (REQUIRED — server refuses to boot without it)
# Plaintext password for the bootstrap admin. It is bcrypt-hashed at
# startup and never stored in plaintext by the server; it does still sit
# in plaintext in your `.env`, so treat that file as a secret.
#
# --- Rotating ADMIN_PASSWORD ---
# IMPORTANT: editing this value and restarting is NOT enough on its own.
# The seed routine only INSERTs the admin when no row with that email
# exists; if the admin is already in the database it logs "Admin user
# already exists" and leaves the stored hash untouched. So:
#
#   Preferred — rotate through the API (updates the stored hash):
#     POST /api/change-password
#     Authorization: Bearer <admin token>
#     { "currentPassword": "<old>", "newPassword": "<new>" }
#   Then update ADMIN_PASSWORD in `.env` to match, so a rebuild from an
#   empty database seeds the same credentials.
#
#   Alternative — force a re-seed (destructive, dev/staging only):
#     Delete the admin row from the `users` table, set the new
#     ADMIN_PASSWORD here, then restart so the seed runs again.
#
# Use a long, unique password from a password manager (16+ chars).
ADMIN_PASSWORD=replace_me_with_a_strong_unique_password


# ------------------------------------------------------------
# Demo data (development only)
# ------------------------------------------------------------
# "true" seeds demo accounts (including an ADMIN, admin@daway.com) that all
# share the password 123456, and RESETS their passwords on every boot.
# Ignored when NODE_ENV=production. Leave unset unless you need the demo.
SEED_DEMO_DATA=


# ------------------------------------------------------------
# Frontend (Vite) — VITE_-prefixed vars are exposed to the browser
# ------------------------------------------------------------
# NEVER put a secret in a VITE_ variable: Vite inlines these into the
# client bundle, where anyone can read them.
# Leave EMPTY in the normal setup: the app calls /api on its own origin
# (server.cjs serves the built app; `npm run dev` proxies /api to port 5000).
# Set it only if the API is hosted on a different domain — and then add the
# app's origin to ALLOWED_ORIGIN above.
VITE_API_BASE=

# "true" (dev server only) serves reads/writes from a localStorage sample when
# the API is unreachable. Login and registration never work offline. Has no
# effect in a production build, which reports the connection error instead.
VITE_ENABLE_OFFLINE_MOCK=
